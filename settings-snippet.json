{
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/hooks/ctx_statusline.py",
    "refreshInterval": 60
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/ctx_warn.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/post_compact.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "timeFormat": "%H:%M:%S",
  "showTurnDuration": true
}
